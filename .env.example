# Copie para .env (na raiz do repositório):  copy .env.example .env
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
PAGAMENTOS_SECRET_KEY=troque-por-outra-chave-grande-e-aleatoria
WEB_SECRET_KEY=troque-por-mais-uma-chave-aleatoria
# Chave que assina os tokens JWT. TEM que ser igual nos dois serviços.
JWT_SIGNING_KEY=troque-por-uma-chave-jwt-compartilhada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,web,.ngrok-free.dev
CORS_ALLOWED_ORIGINS=

# Endereço público (gateway). Usado nos links de pagamento e de retorno.
SITE_URL=http://localhost:8000
PAGAMENTOS_PUBLIC_URL=http://localhost:8000

# AbacatePay: sem chave, o serviço de pagamentos usa o SIMULADOR (bom pra apresentação)
ABACATEPAY_API_KEY=
WEBHOOK_SECRET=

# Push no celular (opcional)
FIREBASE_CREDENTIALS=

# E-mail de verdade (opcional). No Docker o padrão é o Mailpit (http://localhost:8025)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FLOW <nao-responda@flow.local>
